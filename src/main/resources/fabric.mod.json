	"authors": [
		"RevSkyMC"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/terrain-refreshed",
		"sources": "https://github.com/ItsMeRevID/Terrain-Refreshed"
	},
	"license": "MIT",
	"icon": "assets/terrainrefreshed/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.revskymc.terrainrefreshed.TerrainRefreshed"
		]
	},
	"mixins": [
		"terrainrefreshed.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": ">=1.21.1 <1.22",
		"java": ">=21",
		"fabric-api": "*"
	},
	"custom": {
		"minecraft_version": "1.21.1 - 1.21.11",
		"author": "RevSkyMC",
		"package": "net.revskymc.terrainrefreshed"
	}
}
